{
  "info": {
    "_postman_id": "7e18c5de-2453-47b5-a973-0ccdba5897e1",
    "name": "CheckADV Gateway",
    "description": "Testes manuais do Gateway. Selecione o ambiente 'CheckADV Gateway - local'. O pre-request da coleção assina todas as requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Assina com HMAC-SHA256 as rotas /v1 e /admin (mesmo cálculo do AssinadorHmac do gateway-contrato).",
          "// texto = timestamp \\n METODO \\n caminho?query (como enviado) \\n hex(SHA256(corpo))",
          "// Rotas públicas (/actuator, /webhook) não são assinadas.",
          "const caminho = pm.variables.replaceIn(pm.request.url.getPathWithQuery());",
          "const precisaAssinar = caminho.startsWith('/v1/') || caminho.startsWith('/admin/') || caminho === '/admin';",
          "",
          "if (precisaAssinar && pm.environment.get('assinar') !== 'false') {",
          "    const keyId = pm.variables.replaceIn(pm.request.headers.get('X-Usar-Chave') || pm.environment.get('keyId') || '');",
          "    const usaOperador = keyId === pm.environment.get('keyIdOperador');",
          "    const nomeSegredo = usaOperador ? 'segredoOperador' : 'segredo';",
          "    const segredo = pm.environment.get(nomeSegredo);",
          "",
          "    if (!pm.environment.name) {",
          "        throw new Error('Nenhum ambiente selecionado. Escolha \"CheckADV Gateway - local\" no canto superior direito.');",
          "    }",
          "    if (!keyId) {",
          "        throw new Error('Variável \"keyId\" vazia no ambiente.');",
          "    }",
          "    if (!segredo || segredo.startsWith('COLE_AQUI')) {",
          "        throw new Error('Preencha o \"Current value\" da variável \"' + nomeSegredo + '\" no ambiente com o segredo gerado pelo GerarChave.');",
          "    }",
          "",
          "    const ts = Math.floor(Date.now() / 1000).toString();",
          "    const metodo = pm.request.method.toUpperCase();",
          "    const corpo = (pm.request.body && pm.request.body.mode === 'raw')",
          "        ? pm.variables.replaceIn(pm.request.body.raw || '')",
          "        : '';",
          "",
          "    const hashCorpo = CryptoJS.SHA256(corpo).toString(CryptoJS.enc.Hex);",
          "    const texto = ts + '\\n' + metodo + '\\n' + caminho + '\\n' + hashCorpo;",
          "    const assinatura = 'sha256=' + CryptoJS.HmacSHA256(texto, CryptoJS.enc.Base64.parse(segredo))",
          "        .toString(CryptoJS.enc.Hex);",
          "",
          "    pm.request.headers.remove('X-Usar-Chave');",
          "    pm.request.headers.upsert({ key: 'X-Key-Id', value: keyId });",
          "    pm.request.headers.upsert({ key: 'X-Timestamp', value: ts });",
          "    pm.request.headers.upsert({ key: 'X-Assinatura', value: assinatura });",
          "    console.log('Assinado', metodo, caminho, 'keyId=' + keyId);",
          "}"
        ]
      }
    }
  ],
