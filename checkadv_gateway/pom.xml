<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>volvet</groupId>
	<artifactId>checkadv_gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>CheckADV Gateway (pai)</name>
	<description>Gateway WhatsApp e Resolvedor de links do CheckADV</description>

	<!-- Overrides vazios para não herdar metadados do parent do Spring Boot -->
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>gateway-contrato</module>
		<module>gateway-app</module>
		<module>resolvedor-app</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!--
			Versões fora do BOM do Spring Boot entram aqui quando forem usadas
			(Bucket4j, ShedLock, libphonenumber, WireMock), conferidas no Maven Central.
		-->
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>volvet</groupId>
				<artifactId>gateway-contrato</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!--
					O maven-jar-plugin 3.5.0+ (gerenciado pelo Spring Boot) quebra o m2e do Eclipse:
					"Cannot access session scope outside of a scoping block". O build por linha de
					comando não é afetado. Remover quando o m2e corrigir (eclipse-m2e/m2e-core#2084).
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.4.2</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<parameters>true</parameters>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
